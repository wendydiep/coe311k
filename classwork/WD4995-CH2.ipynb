   "source": [
    "def decimal_to_binary(n):\n",
    "    bits = []\n",
    "\n",
    "    while n > 0:\n",
    "        remainder = n % 2\n",
    "        bits.append(str(remainder))\n",
    "        n //= 2\n",
    "\n",
    "    bits.reverse()\n",
    "    return ''.join(bits)\n",
    "\n",
    "\n",
    "print(decimal_to_binary(286523))\n",
    "print(decimal_to_binary(2355))"
   ]
